{
  "name": "codemirror-record",
  "version": "1.1.8",
  "description": "A recording and playing library for CodeMirror. Compatible with version later than 5.37.0.",
  "scripts": {
    "lint": "eslint .",
    "prebuild": "npm run lint",
    "build": "webpack --mode=production",
    "serve": "http-server -o /demo",
    "test": "npm run build && node --test",
    "prepublishOnly": "node scripts/require-publish-tag.cjs && npm test"
  },
  "main": "./dist/main.js",
  "module": "./src/index.js",
  "files": [
    "dist/*",
    "src/*",
    "scripts/*.cjs",
    "*.json",
    "*.js",
    "*.md"
  ],
  "homepage": "https://codemirror-record.haoranyu.com/v1/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jisuanke/CodeMirror-Record.git"
  },
  "keywords": [
    "record",
    "play",
    "codemirror",
    "code"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "babel-loader": "^10.1.1",
    "codemirror": "^5.65.21",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "author": "Haoran Yu",
  "license": "MIT",
  "publishConfig": {
    "tag": "cm5"
  },
  "dependencies": {
    "events": "^3.3.0",
    "lodash.clonedeep": "^4.5.0"
  }
}
